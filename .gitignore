# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tool outputs — downloaded PDFs and their manifests are run artifacts, not source.
# Both source-tool and source-semantic-tool write here. The glob matches the
# directory name exactly, so an alternate --out dir (output_pdf-o/, say) is NOT
# covered and will show up as untracked.
tools/*/output_pdf/

# embeddings-extractor's embedded Qdrant store: page vectors are ~440 KB/page and
# are rebuildable from the PDFs by re-running `index`.
tools/*/qdrant_data/

# Scratch inputs for --from-file batch runs
tools/*/topics.txt
tools/*/descriptions.txt

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Note: the sentence-transformers embedding cache lives in ~/.cache/huggingface,
# outside the repo, so it needs no rule here.
